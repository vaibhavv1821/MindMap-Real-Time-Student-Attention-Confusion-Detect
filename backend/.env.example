# MindMap Backend Environment Configuration
# ==========================================
# IMPORTANT: Safe template only. DO NOT put real credentials into this file.
# Copy this file to .env and insert your real MongoDB Atlas connection string.

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/mindmap?retryWrites=true&w=majority

# Target MongoDB Database Name (default: mindmap)
MONGODB_DATABASE=mindmap

# JWT Authentication Secret & Tokens
JWT_SECRET=mindmap_development_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Frontend URL (Vercel) & CORS Configuration
FRONTEND_URL=https://your-mindmap-frontend.vercel.app
CORS_ORIGINS=["https://your-mindmap-frontend.vercel.app","http://localhost:5173"]

# Port (Render dynamically assigns $PORT at runtime; default is 8000)
PORT=8000

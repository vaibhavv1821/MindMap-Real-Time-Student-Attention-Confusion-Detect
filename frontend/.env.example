# MindMap Frontend Environment Configuration
# ===========================================
# Production API URL (Render Backend Web Service)
# Point this to your deployed Render backend web service URL
VITE_API_BASE_URL=https://your-render-backend.onrender.com/api

# Production WebSocket URL (Render Backend WebSocket)
# Point this to your deployed Render backend WebSocket URL
VITE_WS_BASE_URL=wss://your-render-backend.onrender.com/ws

# Application Display Name
VITE_APP_NAME=MindMap
